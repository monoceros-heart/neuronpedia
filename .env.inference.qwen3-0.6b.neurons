# Qwen3-0.6B raw MLP neurons only, no SAEs: the `neurons` source set, read from each layer's
# mlp.hook_post (the input to down_proj). Small enough for CPU, which is what this is set up for;
# on a GPU, drop DEVICE and MODEL_DTYPE to take the defaults.
# Pair with: make model-add MODEL=qwen3-0.6b LAYERS=28 NEURONS_PER_LAYER=3072 HF_REPO=Qwen/Qwen3-0.6B INFERENCE=1
MODEL_ID=Qwen/Qwen3-0.6B
MODEL_DTYPE=float32
SAE_SETS='[]'
DEVICE=cpu
FORCE_BACKEND=eager
