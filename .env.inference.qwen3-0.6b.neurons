# Raw MLP neurons only (no SAEs): the `neurons` source set, served from the input to each
# layer's down_proj (TransformerLens `mlp.hook_post`). Small enough for CPU, which is how it was
# first run; on a GPU drop DEVICE and MODEL_DTYPE to take the defaults.
MODEL_ID=Qwen/Qwen3-0.6B
MODEL_DTYPE=float32
SAE_SETS='[]'
DEVICE=cpu
FORCE_BACKEND=eager
NEURONPEDIA_MODEL_ID=qwen3-0.6b
