# ========================== Required Variables ==========================

# Domain of your main site
NEXT_PUBLIC_URL=http://localhost:3000          

# Auth will redirect to this domain
NEXTAUTH_URL=http://localhost:3000         

# Local mode: no sign-in for the admin panel and the dataset-import routes. Defaults to on exactly
# when NEXT_PUBLIC_URL is http://localhost:3000. Set it to true to browse this instance at another
# address (put that address in NEXT_PUBLIC_URL and NEXTAUTH_URL), or false to turn it off.
# `make webapp-dev` listens on 127.0.0.1 only unless given BIND=0.0.0.0, since local mode leaves
# the admin routes open to anyone who can reach the port.
# NEXT_PUBLIC_LOCAL_MODE=true

# Datasets for the admin importers. Unset, they come from Neuronpedia's public bucket. Name your own
# bucket, laid out the same way (v1/config/..., v1/<model>/<source>/...), to import exports that
# were never published. For Cloudflare R2, set the endpoint, region auto and an R2 API token's
# keys; put the keys in the gitignored .env.localhost.local rather than here. Read at boot.
# NEURONPEDIA_DATASETS_URL=s3://my-datasets
# Or a local directory with the same layout, for exports that were never uploaded:
# NEURONPEDIA_DATASETS_URL=file:///path/to/datasets
# NEURONPEDIA_DATASETS_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# NEURONPEDIA_DATASETS_REGION=auto
# NEURONPEDIA_DATASETS_ACCESS_KEY_ID=
# NEURONPEDIA_DATASETS_SECRET_ACCESS_KEY=

# Secret for hashing auth tokens
NEXTAUTH_SECRET=88888888888888888888888888888888 

# Database
POSTGRES_PRISMA_URL="postgres://postgres:postgres@localhost:5432/postgres?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://postgres:postgres@localhost:5432/postgres"

# ========================== Local Services ==========================

# Which deployment this is. Registering a GPU host that disagrees is rejected.
NEURONPEDIA_ENVIRONMENT=dev

# Inference, graph and NLA servers are looked up in the ComputeHost table.
# After starting one (make inference-dev), register it:
#   make host-add SERVICE=INFERENCE MODEL=gpt2-small URL=http://127.0.0.1:5002 SOURCES=6-res-jb
# Autointerp is still a single server chosen by env var.
USE_LOCALHOST_AUTOINTERP=false

# Must match LOCALHOST_SECRET in the root Makefile.
INFERENCE_SERVER_SECRET=localhost-secret
AUTOINTERP_SERVER_SECRET=localhost-secret
GRAPH_SERVER_SECRET=localhost-secret

# ========================== Default Values ==========================

NEXT_PUBLIC_ENABLE_SIGNIN=false
NEXT_PUBLIC_DEMO_MODE=false

# The contact email address for errors
NEXT_PUBLIC_CONTACT_EMAIL_ADDRESS=johnny@neuronpedia.org

# Default Model, Source Set, and Release for dropdowns/selectors
NEXT_PUBLIC_DEFAULT_MODELID=gemma-2-2b
NEXT_PUBLIC_DEFAULT_SOURCESET=gemmascope-res-16k
NEXT_PUBLIC_DEFAULT_SOURCE=20-gemmascope-res-16k
NEXT_PUBLIC_DEFAULT_RELEASE_NAME=gemma-scope

# Default User IDs
DEFAULT_CREATOR_USER_ID=clkht01d40000jv08hvalcvly
# The first id is the creator of activations uploaded through /api/feature/upload-batch, so it must
# be a user that exists: the seeded `bot` (clkht01d40000jv08hvalcvly) comes first for that reason.
PUBLIC_ACTIVATIONS_USER_IDS=clkht01d40000jv08hvalcvly,clsxqq2xd0000vvp2k5itlhqj,cljqfoqm1000776wmbr1f5mux,cljj57d3c000076ei38vwnv35
INFERENCE_ACTIVATION_USER_ID=cljgamm90000076zdchicy6zj

# Defaults for Steering
NEXT_PUBLIC_DEFAULT_STEER_MODEL=gemma-2-2b-it
NEXT_PUBLIC_STEER_FORCE_ALLOW_INSTRUCT_MODELS=gemma-2-2b-it

# Models whose inference servers load the J++ Lens (JPP_LENS=true). Comma-separated.
NEXT_PUBLIC_JPP_LENS_MODEL_IDS=