# Qwen3-8B raw MLP neurons only, no SAEs: the `neurons` source set, read from each layer's
# mlp.hook_post (the input to down_proj). Needs a GPU with room for the bf16 weights (~16 GB).
# Eager like the 0.6B config; the vLLM backend was not tried with raw neurons here.
# Pair with: make model-add MODEL=qwen3-8b LAYERS=36 NEURONS_PER_LAYER=12288 HF_REPO=Qwen/Qwen3-8B INFERENCE=1
MODEL_ID=Qwen/Qwen3-8B
MODEL_DTYPE=auto
SAE_SETS='[]'
FORCE_BACKEND=eager
